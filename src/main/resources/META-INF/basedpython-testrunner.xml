<!--
  Loaded only when the Test Runner plugin is present.

  The dependency itself was the original point: the SM test runner (SMTRunnerConsoleProperties,
  OutputToGeneralTestEventsConverter, SMTestLocator, …) left the core platform in 2026.2 for the
  bundled `intellij.testRunner.plugin`, so without this the test configuration's classes do not
  resolve there — 19 NoSuchClassError risks, which is exactly what the plugin verifier reported.
  Still optional now that the floor is 2026.2, where the plugin is always bundled — but optional
  costs nothing and a required dependency is not free: it is a load-time condition, so any product
  in the supported range that ships without this plugin would stop loading basedpython entirely
  rather than lose its test tree. Nothing here needs to run where the interface does not exist.

  The listener below belongs here for the same reason: it implements an SM runner interface, so it
  may only be instantiated where that interface exists. So do the test configuration type and the
  producer that makes its configurations: the configuration they create runs under the SM test
  runner, and registered from plugin.xml they were loaded whether or not that runner exists.

  And so do the two views of a project's tests. The gutter icon runs a test through that producer,
  and the test tree runs, debugs and reports on tests through that configuration type — which
  `ConfigurationTypeUtil` cannot find, and throws for, where this file was not loaded.
-->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <configurationType
            implementation="dev.basedpython.pycharm.run.test.ByTestConfigurationType"/>
        <!-- Precedence against the `by run` and `by check` producers is decided in code, not by
             registration order; see ByRunFromFileProducer. -->
        <runConfigurationProducer implementation="dev.basedpython.pycharm.run.ByTestFromFileProducer"/>
        <runLineMarkerContributor
            language="basedpython"
            implementationClass="dev.basedpython.pycharm.run.testmarker.ByTestRunLineMarkerContributor"/>
        <!-- The project's tests, the counterpart of the run window's results tree: which tests
             exist, before anything has run. -->
        <toolWindow id="basedpython Tests"
                    anchor="right"
                    icon="/icons/basedpythonTests.svg"
                    factoryClass="dev.basedpython.pycharm.run.test.node.ByTestNodeToolWindowFactory"/>
    </extensions>

    <projectListeners>
        <!-- Test outcomes for the node view's tree, from every run the SM runner reports —
             whichever button started it. -->
        <listener class="dev.basedpython.pycharm.run.test.node.ByTestRunStateListener"
                  topic="com.intellij.execution.testframework.sm.runner.SMTRunnerEventsListener"/>
    </projectListeners>
</idea-plugin>
